include armv7-a/Make.defs

CHIP_ASRCS  =
CHIP_CSRCS  = t113_boot.c t113_serial.c t113_irq.c t113_lowputc.c

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += t113_timerisr.c
endif

ifeq ($(CONFIG_T113_BOOT0),y)
CHIP_CSRCS += t113_load.c
CHIP_ASRCS += t113_boot0.S
t113_load.c_CFLAGS = -fno-lto -O3 -fno-stack-protector
endif

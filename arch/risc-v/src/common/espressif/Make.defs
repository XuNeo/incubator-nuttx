STORAGETMP = $(if $(wildcard $(NXTMPDIR)/.*),y,)

# The start-up, "head", file. May be either a .S or a .c file.

HEAD_ASRC   = esp_head.S

# Skip common RISC-V vector table in favor of Espressif's custom vector
# table.

CMN_ASRCS  := $(filter-out riscv_vectors.S,$(CMN_ASRCS))
CHIP_ASRCS  = esp_vectors.S

# Required Espressif chip's files (arch/risc-v/src/common/espressif)

CHIP_CSRCS  = esp_allocateheap.c esp_start.c esp_idle.c
CHIP_CSRCS += esp_irq.c esp_gpio.c esp_rtc_gpio.c esp_libc_stubs.c
CHIP_CSRCS += esp_lowputc.c esp_serial.c
CHIP_CSRCS += esp_systemreset.c

ifeq ($(CONFIG_SCHED_TICKLESS),y)
	CHIP_CSRCS += esp_tickless.c
else
	CHIP_CSRCS += esp_timerisr.c
endif

ifeq ($(CONFIG_ESPRESSIF_WDT),y)
	CHIP_CSRCS += esp_wdt.c
endif

ifneq ($(CONFIG_DEV_RANDOM)$(CONFIG_DEV_URANDOM_ARCH),)
	CHIP_CSRCS += esp_random.c
endif

ifeq ($(CONFIG_TIMER),y)
	CHIP_CSRCS += esp_timer.c
endif

ifeq ($(CONFIG_ONESHOT),y)
	CHIP_CSRCS += esp_oneshot.c
endif

ifeq ($(CONFIG_RTC),y)
	CHIP_CSRCS += esp_rtc.c
endif

ifeq ($(CONFIG_ESPRESSIF_HR_TIMER),y)
	CHIP_CSRCS += esp_hr_timer.c esp_ets_timer_legacy.c
endif

ifeq ($(CONFIG_ESPRESSIF_DMA),y)
	CHIP_CSRCS += esp_dma.c
endif

ifeq ($(CONFIG_ESPRESSIF_EFUSE),y)
	CHIP_CSRCS += esp_efuse.c
endif

ifeq ($(CONFIG_ESPRESSIF_TWAI),y)
	CHIP_CSRCS += esp_twai.c
endif

ifeq ($(CONFIG_ESPRESSIF_LEDC),y)
	CHIP_CSRCS += esp_ledc.c
endif

ifeq ($(CONFIG_ESP_PCNT),y)
	CHIP_CSRCS += esp_pcnt.c
	ifeq ($(CONFIG_ESP_PCNT_AS_QE),y)
		CHIP_CSRCS += esp_qencoder.c
	endif
endif

ifeq ($(CONFIG_ESPRESSIF_USBSERIAL),y)
	CHIP_CSRCS += esp_usbserial.c
endif

ifeq ($(CONFIG_ESP_RMT),y)
	CHIP_CSRCS += esp_rmt.c
	ifeq ($(CONFIG_WS2812_NON_SPI_DRIVER),y)
		CHIP_CSRCS += esp_ws2812.c
	endif
endif

ifeq ($(CONFIG_ESP_SDM),y)
	CHIP_CSRCS += esp_sdm.c
endif

ifeq ($(CONFIG_ESPRESSIF_DEDICATED_GPIO),y)
	CHIP_CSRCS += esp_dedic_gpio.c
endif

ifeq ($(CONFIG_ESPRESSIF_TEMP),y)
	CHIP_CSRCS += esp_temperature_sensor.c
endif

ifeq ($(CONFIG_ESPRESSIF_I2C),y)
	ifeq ($(CONFIG_ESPRESSIF_I2C_PERIPH_MASTER_MODE),y)
		CHIP_CSRCS += esp_i2c.c
	endif
	ifeq ($(CONFIG_ESPRESSIF_I2C_BITBANG),y)
		CHIP_CSRCS += esp_i2c_bitbang.c
	endif
	ifeq ($(CONFIG_ESPRESSIF_I2C_PERIPH_SLAVE_MODE),y)
		CHIP_CSRCS += esp_i2c_slave.c
	endif
endif

ifeq ($(CONFIG_ESPRESSIF_I2S),y)
CHIP_CSRCS += esp_i2s.c
endif

ifeq ($(CONFIG_ESPRESSIF_SPI),y)
	ifeq ($(CONFIG_ESPRESSIF_SPI_PERIPH),y)
		CHIP_CSRCS += esp_spi.c
	endif
	ifeq ($(CONFIG_SPI_SLAVE),y)
		CHIP_CSRCS += esp_spi_slave.c
	endif
	ifeq ($(CONFIG_ESPRESSIF_SPI_BITBANG),y)
		CHIP_CSRCS += esp_spi_bitbang.c
	endif
endif

ifeq ($(CONFIG_ESPRESSIF_SPIFLASH),y)
	CHIP_CSRCS += esp_spiflash.c
	ifeq ($(CONFIG_ESPRESSIF_MTD),y)
		CHIP_CSRCS += esp_spiflash_mtd.c
	endif
endif

ifeq ($(CONFIG_ESP_WIRELESS),y)
	ifeq ($(CONFIG_ESPRESSIF_WIFI),y)
		CHIP_CSRCS += esp_wifi_event_handler.c
		CHIP_CSRCS += esp_wifi_api.c
		CHIP_CSRCS += esp_wlan_netdev.c
	endif
	CHIP_CSRCS += esp_wifi_utils.c
endif

ifeq ($(CONFIG_ESP_MCPWM),y)
	CHIP_CSRCS += esp_mcpwm.c
endif

ifeq ($(CONFIG_SYSTEM_NXDIAG_ESPRESSIF_CHIP_WO_TOOL),y)
	CHIP_CSRCS += esp_nxdiag.c
endif

ifeq ($(CONFIG_ESPRESSIF_ADC),y)
CHIP_CSRCS += esp_adc.c
endif

ifeq ($(CONFIG_ESPRESSIF_SHA_ACCELERATOR),y)
	CHIP_CSRCS += esp_sha.c
endif

ifeq ($(CONFIG_CRYPTO_CRYPTODEV_HARDWARE),y)
	CHIP_CSRCS += esp_crypto.c
endif

ifeq ($(CONFIG_ESPRESSIF_USE_LP_CORE), y)
	CHIP_CSRCS += esp_ulp.c
endif

ifeq ($(CONFIG_PM),y)
	ifneq ($(CONFIG_ARCH_CUSTOM_PMINIT),y)
		CHIP_CSRCS += esp_pm_initialize.c
	endif
	CHIP_CSRCS += esp_pm.c
	LDFLAGS += -u esp_timer_init_include_func
endif

# Required for initialization hooks on common code

LDFLAGS += -u esp_system_include_startup_funcs

ifeq ($(CONFIG_ESPRESSIF_EFUSE),y)
	LDFLAGS += -u esp_efuse_startup_include_func
endif

#############################################################################
# Espressif HAL for 3rd Party Platforms
#############################################################################

# Fetch source files and add them to build

ESP_HAL_3RDPARTY_REPO   = esp-hal-3rdparty

ifndef ESP_HAL_3RDPARTY_VERSION
	ESP_HAL_3RDPARTY_VERSION = bb255ca422f4b4d60c9f4f74dbdf51316dc2b669
endif

# Tarball download configuration (following opensbi pattern)
ESP_HAL_3RDPARTY_TARBALL = $(ESP_HAL_3RDPARTY_VERSION).tar.gz
ESP_HAL_3RDPARTY_UNPACKNAME = $(ESP_HAL_3RDPARTY_REPO)-$(ESP_HAL_3RDPARTY_VERSION)
ESP_HAL_3RDPARTY_URL_BASE = https://github.com/espressif/esp-hal-3rdparty/archive

# mbedtls submodule (required for basic functionality)
MBEDTLS_VERSION = 98ae8db06b8acc1dc1c6b1f78c2719cb776f4147
MBEDTLS_TARBALL = $(MBEDTLS_VERSION).tar.gz
MBEDTLS_UNPACKNAME = mbedtls-$(MBEDTLS_VERSION)
MBEDTLS_URL_BASE = https://github.com/espressif/mbedtls/archive

# WIRELESS submodules (required when CONFIG_ESP_WIRELESS=y)
ifeq ($(CONFIG_ESP_WIRELESS),y)
ESP_PHY_VERSION = 2fb71262baf38dc83591b4191731a0880bfdd3a5
ESP_PHY_TARBALL = $(ESP_PHY_VERSION).tar.gz
ESP_PHY_URL_BASE = https://github.com/espressif/esp-phy-lib/archive

ESP_WIFI_VERSION = 7587592417ecdb5163a104aebaedee0a87794608
ESP_WIFI_TARBALL = $(ESP_WIFI_VERSION).tar.gz
ESP_WIFI_URL_BASE = https://github.com/espressif/esp32-wifi-lib/archive

ESP_BT_VERSION = 72599d583c232ea78d6461b5b502426c6e5a1ec9
ESP_BT_TARBALL = $(ESP_BT_VERSION).tar.gz
ESP_BT_URL_BASE = https://github.com/espressif/esp32c3-bt-lib/archive

ESP_COEX_VERSION = cb6667841f63457246d56a9170f3409917e9d5a8
ESP_COEX_TARBALL = $(ESP_COEX_VERSION).tar.gz
ESP_COEX_URL_BASE = https://github.com/espressif/esp-coex-lib/archive
endif

# Download tarballs using standard DOWNLOAD macro
$(ESP_HAL_3RDPARTY_TARBALL):
	$(call DOWNLOAD,$(ESP_HAL_3RDPARTY_URL_BASE),$(ESP_HAL_3RDPARTY_TARBALL))

$(MBEDTLS_TARBALL):
	$(call DOWNLOAD,$(MBEDTLS_URL_BASE),$(MBEDTLS_TARBALL))

ifeq ($(CONFIG_ESP_WIRELESS),y)
$(ESP_PHY_TARBALL):
	$(call DOWNLOAD,$(ESP_PHY_URL_BASE),$(ESP_PHY_TARBALL))

$(ESP_WIFI_TARBALL):
	$(call DOWNLOAD,$(ESP_WIFI_URL_BASE),$(ESP_WIFI_TARBALL))

$(ESP_BT_TARBALL):
	$(call DOWNLOAD,$(ESP_BT_URL_BASE),$(ESP_BT_TARBALL))

$(ESP_COEX_TARBALL):
	$(call DOWNLOAD,$(ESP_COEX_URL_BASE),$(ESP_COEX_TARBALL))
endif

# Unpack and prepare HAL with mbedtls submodule
ifeq ($(CONFIG_ESP_WIRELESS),y)
.esp_hal_3rdparty_unpack: $(ESP_HAL_3RDPARTY_TARBALL) $(MBEDTLS_TARBALL) $(ESP_PHY_TARBALL) $(ESP_WIFI_TARBALL) $(ESP_BT_TARBALL) $(ESP_COEX_TARBALL)
else
.esp_hal_3rdparty_unpack: $(ESP_HAL_3RDPARTY_TARBALL) $(MBEDTLS_TARBALL)
endif
	$(Q) echo "Unpacking: ESP HAL 3rdparty $(ESP_HAL_3RDPARTY_VERSION)"
	$(Q) tar xzf $(ESP_HAL_3RDPARTY_TARBALL)
	$(Q) mv $(ESP_HAL_3RDPARTY_UNPACKNAME) chip/$(ESP_HAL_3RDPARTY_REPO)
	$(Q) echo "Unpacking: mbedtls $(MBEDTLS_VERSION)"
	$(Q) mkdir -p chip/$(ESP_HAL_3RDPARTY_REPO)/components/mbedtls/mbedtls
	$(Q) tar xzf $(MBEDTLS_TARBALL) --strip-components=1 -C chip/$(ESP_HAL_3RDPARTY_REPO)/components/mbedtls/mbedtls
ifeq ($(CONFIG_ESP_WIRELESS),y)
	$(Q) echo "Unpacking: esp-phy-lib $(ESP_PHY_VERSION)"
	$(Q) mkdir -p chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_phy/lib
	$(Q) tar xzf $(ESP_PHY_TARBALL) --strip-components=1 -C chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_phy/lib
	$(Q) echo "Unpacking: esp32-wifi-lib $(ESP_WIFI_VERSION)"
	$(Q) mkdir -p chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_wifi/lib
	$(Q) tar xzf $(ESP_WIFI_TARBALL) --strip-components=1 -C chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_wifi/lib
	$(Q) echo "Unpacking: esp32c3-bt-lib $(ESP_BT_VERSION)"
	$(Q) mkdir -p chip/$(ESP_HAL_3RDPARTY_REPO)/components/bt/controller/lib_esp32c3_family
	$(Q) tar xzf $(ESP_BT_TARBALL) --strip-components=1 -C chip/$(ESP_HAL_3RDPARTY_REPO)/components/bt/controller/lib_esp32c3_family
	$(Q) echo "Unpacking: esp-coex-lib $(ESP_COEX_VERSION)"
	$(Q) mkdir -p chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_coex/lib
	$(Q) tar xzf $(ESP_COEX_TARBALL) --strip-components=1 -C chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_coex/lib
	$(Q) echo "Applying mbedTLS patches..."
	$(Q) cd chip/$(ESP_HAL_3RDPARTY_REPO)/components/mbedtls/mbedtls && \
		for patch in ../../../nuttx/patches/components/mbedtls/mbedtls/*.patch; do \
			patch -p1 -s < $$patch; \
		done
endif
	$(Q) touch .esp_hal_3rdparty_unpack

# Only download if not a git repository (developer mode)
ifeq ($(wildcard chip/$(ESP_HAL_3RDPARTY_REPO)/.git),)
context:: .esp_hal_3rdparty_unpack
endif

include common$(DELIM)espressif$(DELIM)Bootloader.mk

# Silent preprocessor warnings

CFLAGS += -Wno-undef -Wno-unused-variable -fno-jump-tables -fno-tree-switch-conversion

# Remove quotes from CONFIG_ESPRESSIF_CHIP_SERIES configuration

CHIP_SERIES = $(patsubst "%",%,$(CONFIG_ESPRESSIF_CHIP_SERIES))

include chip/hal_${CHIP_SERIES}.mk

ifeq ($(CONFIG_ESP_WIRELESS),y)
	include common$(DELIM)espressif$(DELIM)Wireless.mk
endif

# Copy required header files
context:: chip/$(ESP_HAL_3RDPARTY_REPO)
	$(call COPYFILE,chip/$(ESP_HAL_3RDPARTY_REPO)/components/soc/$(CHIP_SERIES)/include/soc/gpio_sig_map.h,../include/chip/)
	$(call COPYFILE,chip/$(ESP_HAL_3RDPARTY_REPO)/nuttx/$(CHIP_SERIES)/include/irq.h,../include/chip/)

distclean::
	$(call DELFILE,../include/chip/gpio_sig_map.h)
	$(call DELFILE,../include/chip/irq.h)
	$(call DELFILE,../../../vefuse.bin)
ifeq ($(wildcard chip/$(ESP_HAL_3RDPARTY_REPO)/.git),)
	$(call DELFILE,.esp_hal_3rdparty_unpack)
	$(call DELFILE,$(ESP_HAL_3RDPARTY_TARBALL))
	$(call DELFILE,$(MBEDTLS_TARBALL))
ifeq ($(CONFIG_ESP_WIRELESS),y)
	$(call DELFILE,$(ESP_PHY_TARBALL))
	$(call DELFILE,$(ESP_WIFI_TARBALL))
	$(call DELFILE,$(ESP_BT_TARBALL))
	$(call DELFILE,$(ESP_COEX_TARBALL))
endif
	$(call DELDIR,chip/$(ESP_HAL_3RDPARTY_REPO))
endif
ifeq ($(CONFIG_ESPRESSIF_USE_LP_CORE),y)
	$(call DELDIR,chip/ulp)
endif

INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)common$(DELIM)espressif
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)common$(DELIM)espressif$(DELIM)platform_include
VPATH += common$(DELIM)espressif
